<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- WiFi-only tablet: no voice, SMS, or mobile data -->
    <bool name="config_voice_capable">false</bool>
    <bool name="config_sms_capable">false</bool>
    <bool name="config_mobile_data_capable">false</bool>

    <!-- Network attributes for WiFi-only device -->
    <string-array translatable="false" name="networkAttributes">
        <item>"wifi,1,1,1,-1,true"</item>
        <item>"bluetooth,7,7,0,-1,true"</item>
        <item>"wifi_p2p,13,1,0,-1,true"</item>
        <item>"ethernet,9,9,2,-1,true"</item>
    </string-array>

    <string-array translatable="false" name="radioAttributes">
        <item>"1,1"</item>
        <item>"0,1"</item>
    </string-array>

    <!-- Is the notification LED intrusive? Used to decide if there should be a disable option -->
    <bool name="config_intrusiveNotificationLed">true</bool>

    <!-- Whether a software navigation bar should be shown. -->
    <bool name="config_showNavigationBar">true</bool>

    <!-- If this is true, the screen will come on when you unplug usb/power/whatever. -->
    <bool name="config_unplugTurnsOnScreen">true</bool>

    <!-- Auto brightness -->
    <bool name="config_automatic_brightness_available">true</bool>

    <integer-array name="config_autoBrightnessLevels">
        <item>2</item>
        <item>7</item>
        <item>15</item>
        <item>50</item>
        <item>100</item>
        <item>200</item>
        <item>400</item>
        <item>1000</item>
        <item>2000</item>
        <item>3000</item>
        <item>5000</item>
        <item>10000</item>
    </integer-array>

    <integer-array name="config_autoBrightnessLcdBacklightValues">
        <item>12</item>
        <item>22</item>
        <item>32</item>
        <item>42</item>
        <item>52</item>
        <item>62</item>
        <item>72</item>
        <item>82</item>
        <item>96</item>
        <item>134</item>
        <item>178</item>
        <item>225</item>
        <item>255</item>
    </integer-array>

    <integer name="config_screenBrightnessSettingMinimum">1</integer>
    <integer name="config_screenBrightnessDark">1</integer>

    <!-- Doze -->
    <bool name="config_dozeAfterScreenOffByDefault">true</bool>
    <integer name="config_screenBrightnessDoze">3</integer>
    <bool name="config_dozeAlwaysOnDisplayAvailable">true</bool>
    <bool name="config_dozeAlwaysOnEnabled">false</bool>
    <bool name="config_enableAutoPowerModes">true</bool>
    <bool name="config_powerDecoupleInteractiveModeFromDisplay">true</bool>

    <!-- Tablet rotation -->
    <bool name="config_allowAllRotations">true</bool>
    <bool name="config_enableLockScreenRotation">true</bool>

    <!-- No permanent menu key -->
    <integer name="config_overrideHasPermanentMenuKey">2</integer>

    <!-- SD card accessible without removing battery -->
    <bool name="config_batterySdCardAccessibility">true</bool>

    <!-- Book cover: lid controls sleep -->
    <bool name="config_lidControlsSleep">true</bool>

    <!-- Double tap to wake -->
    <bool name="config_supportDoubleTapWake">true</bool>

    <!-- Freeform window management for tablet -->
    <bool name="config_freeformWindowManagement">true</bool>

    <!-- Desktop mode support -->
    <bool name="config_canInternalDisplayHostDesktops">true</bool>

    <!-- Rounded corners on windows -->
    <bool name="config_supportsRoundedCornersOnWindows">true</bool>
</resources>
