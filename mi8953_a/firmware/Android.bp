install_symlink {
    name: "symlink_firmware_mi8953_a",
    vendor: true,
    installed_location: "firmware/qcom/msm8953/xiaomi",
    symlink_target: "/odm/firmware/qcom/msm8953/xiaomi",
}

/*
```bash
for d in daisy markw mido onclite oxygen rosy vince ysl; do
for f in a506_zap.b{00..02} a506_zap.mdt; do
echo "install_symlink {
    name: \"symlink_firmware_mi8953_a_${d}_${f}\",
    device_specific: true,
    installed_location: \"firmware/qcom/msm8953/xiaomi/${d}/${f}\",
    symlink_target: \"../${f}\",
}
"
done
done
```

```bash
for d in daisy markw mido onclite oxygen rosy vince ysl; do
for f in a506_zap.b{00..02} a506_zap.mdt; do
echo "        \"symlink_firmware_mi8953_a_${d}_${f}\","
done
done
```
*/

