# CPU Governor Toggles
on property:vendor.perf.cpu_gov=true
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor "performance"
    write /sys/class/devfreq/soc:qcom,cpubw/governor "performance"

on property:vendor.perf.cpu_gov=false
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor "schedutil"
    write /sys/class/devfreq/soc:qcom,cpubw/governor "bw_hwmon"

# GPU Governor Toggles
on property:vendor.perf.gpu_gov=true
    write /sys/class/kgsl/kgsl-3d0/devfreq/governor "performance"
    write /sys/class/devfreq/soc:qcom,gpubw/governor "performance"

on property:vendor.perf.gpu_gov=false
    write /sys/class/kgsl/kgsl-3d0/devfreq/governor "msm-adreno-tz"
    write /sys/class/devfreq/soc:qcom,gpubw/governor "bw_vbif"

# GPU Overclocking
on property:vendor.perf.gpu_oc=*
    write /sys/class/kgsl/kgsl-3d0/gpu_oc_mhz ${vendor.perf.gpu_oc}
