android_app {
    name: "SamsungPerformance",

    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,
    privileged: true,

    static_libs: [
        "SettingsLib",
        "SpaLib",
        "androidx.preference_preference",
        "com.google.android.material_material",
        "org.lineageos.settings.resources",
    ],
}

prebuilt_etc {
    name: "init.perf.rc",
    src: "init.perf.rc",
    sub_dir: "init",
    vendor: true,
}
