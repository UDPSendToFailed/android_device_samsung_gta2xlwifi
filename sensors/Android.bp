cc_binary {
    name: "android.hardware.sensors-service.samsung-gta2xlwifi",
    vendor: true,
    compile_multilib: "32",
    relative_install_path: "hw",
    init_rc: ["android.hardware.sensors-service.samsung-gta2xlwifi.rc"],
    vintf_fragments: ["android.hardware.sensors-service.samsung-gta2xlwifi.xml"],
    srcs: [
        "SensorsHalAidl.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "android.hardware.sensors-V3-ndk",
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "libfmq",
        "libhardware",
        "liblog",
        "libpower",
        "libutils",
    ],
    static_libs: [
        "android.hardware.sensors-V1-convert",
        "libaidlcommonsupport",
        "android.hardware.common-V2-ndk",
        "android.hardware.common.fmq-V1-ndk",
    ],
}
