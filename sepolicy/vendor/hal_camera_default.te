allow hal_camera_default app_efs_file:dir rw_dir_perms;
allow hal_camera_default app_efs_file:file rw_file_perms;

allow hal_camera_default sysfs_camera_writable:dir r_dir_perms;
allow hal_camera_default sysfs_camera_writable:file rw_file_perms;

allow hal_camera_default sysfs_sensors:file r_file_perms;

r_dir_file(hal_camera_default, efs_file)
r_dir_file(hal_camera_default, sec_poc_file)

get_prop(hal_camera_default, vendor_factory_prop)
set_prop(hal_camera_default, sec_camera_prop)

# Camera data file access
allow hal_camera_default camera_data_file:dir { search read write add_name };
allow hal_camera_default camera_data_file:file { read write open getattr create };

# Camera flash sysfs access
allow hal_camera_default sysfs:file { read write open };

# Property access for default_prop
allow hal_camera_default default_prop:file { read open getattr map };

# Graphics allocator service access
allow hal_camera_default hal_graphics_allocator_service:service_manager find;

# Property access for camera operation
get_prop(hal_camera_default, bootanim_system_prop)
get_prop(hal_camera_default, persist_debug_prop)
