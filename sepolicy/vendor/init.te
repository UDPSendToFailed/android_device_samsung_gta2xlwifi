allow init omr_file:dir mounton;
allow init hidl_base_hwservice:hwservice_manager add;
allow init sysfs:file setattr;
allow init vendor_file:file execute;

allow init sysfs:dir create;
allow init vendor_data_file:file rename;
allow init vendor_file:file execute_no_trans;

allow init efs_file:dir mounton;
allow init hwservicemanager:binder { call transfer };
allow init proc:file setattr;
allow init same_process_hal_file:file execute;

# Sysfs access for sensors HAL (poll_delay, enable, flush)
allow init sysfs:file { write open };

# Sysfs graphics access for light HAL (brightness)
allow init sysfs_graphics:file { read write open getattr };

# Sysfs sensors symlink access
allow init sysfs_sensors:lnk_file read;

# Discard max bytes sysfs access
allow init sysfs:file write;
