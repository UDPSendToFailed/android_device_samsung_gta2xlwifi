allow qti_init_shell mnt_vendor_file:dir create_dir_perms;

allow qti_init_shell sensors_persist_file:dir create_dir_perms;

allow qti_init_shell vendor_data_file:file { getattr setattr };

set_prop(qti_init_shell, ctl_default_prop)

# Proc sched access for sched_boost
allow qti_init_shell proc_sched:file { write open };

# read_ahead_kb tuning
allow qti_init_shell sysfs:file write;
